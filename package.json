{
  "name": "anime-hub",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run build && wrangler pages dev out --port 8788",
    "build": "next build",
    "preview": "wrangler pages dev out --port 8788",
    "typecheck": "tsc --noEmit",
    "check:pages": "wrangler pages functions build functions --outdir .wrangler/check",
    "deploy": "wrangler pages deploy out"
  },
  "license": "MIT",
  "description": "A bilingual anime catalogue for Cloudflare Pages.",
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
